# PROPOSAL ONLY -- NOT APPLIED, NOT APPLICABLE UPSTREAM WITHOUT REVIEW
#
# Target : quantbt/optimization/candidate_selection.py  (quantbt-engine 1.1.1, PyPI)
# Scope  : the CandidateSelector / MultiSeedOptimization family ONLY.
#          quantbt/walkforward.py is NOT affected and needs no change: its
#          _is_clusterable_param already drops non-varying parameters and its
#          _normalize_param_values already normalises by the DECLARED param_ranges.
#          The proposal is simply to give this family the geometry the same package
#          already uses in the other one.
# Origin : LAB-04 L04.2 counterexamples CE-04, CE-05, CE-06
#          (configs/lab04_selector_counterexamples.json)
# Status : never applied to /root/bobby/pool_alpha/quantbt, never applied to the
#          installed wheel in environments/lab_venv. The lab does not depend on
#          this being fixed; its own selector uses declared-bound geometry.
#
# Measured on the installed function, reproducers in the counterexample artifact:
#   CE-05 sampled-span scaling
#         d(a,b) = 0.577350 with two records; add ONE record at fast=200 and the
#         SAME two points become d = 0.005891, a 98x collapse. Nothing about a or b
#         changed.
#   CE-04 fixed-dimension dilution
#         with a constant `dev` in param_names   d = 0.577350
#         without it                             d = 0.707107
#         a parameter that never varies carries no information yet moves every
#         distance and, through eps-style thresholds, every cluster decision.
#   CE-06 inactive-parameter false distance
#         two points identical except that a conditional branch is off in one of
#         them measure d = 0.5, because a missing value is not numeric and the
#         else-branch charges a full unit.
#
# The signature change is additive: `ranges` is optional and the behaviour is
# unchanged when it is not supplied, so no existing caller breaks.

--- a/quantbt/optimization/candidate_selection.py
+++ b/quantbt/optimization/candidate_selection.py
@@
 def _param_distance(
     left: dict[str, Any],
     right: dict[str, Any],
     records: Iterable[OptimizationTrialRecord],
     param_names: list[str],
+    ranges: dict[str, Any] | None = None,
 ) -> float:
     if not param_names:
         return 0.0
+    # Only parameters that actually vary carry information. A constant dimension
+    # inflates the denominator and shrinks every distance uniformly.
+    varying = [
+        name for name in param_names
+        if len({str(record.params.get(name)) for record in records}) > 1
+    ]
+    if not varying:
+        return 0.0
     total = 0.0
-    for name in param_names:
+    counted = 0
+    for name in varying:
         lv = left.get(name)
         rv = right.get(name)
+        # An INACTIVE conditional parameter is absent on one side. That is a branch
+        # difference, not a coordinate difference, and charging it a full unit of
+        # distance manufactures separation between points that are otherwise equal.
+        if (lv is None) != (rv is None):
+            continue
+        if lv is None and rv is None:
+            continue
         if _is_numeric(lv) and _is_numeric(rv):
-            span = _numeric_span(records, name)
+            # Prefer the DECLARED bound. The sampled span makes the geometry depend
+            # on which points the optimizer happened to visit, so one distant trial
+            # rescales the distance between two unrelated, unchanged points.
+            span = _declared_span(ranges, name)
+            if span <= 0.0:
+                span = _numeric_span(records, name)
             diff = 0.0 if span <= 0.0 else abs(float(lv) - float(rv)) / span
+            diff = min(1.0, diff)
         else:
             diff = 0.0 if lv == rv else 1.0
         total += diff * diff
-    return math.sqrt(total / len(param_names))
+        counted += 1
+    return math.sqrt(total / counted) if counted else 0.0
+
+
+def _declared_span(ranges: dict[str, Any] | None, name: str) -> float:
+    """Span from the declared search space, mirroring walkforward._normalize_param_values."""
+    if not ranges or name not in ranges:
+        return 0.0
+    spec = ranges[name]
+    if isinstance(spec, (tuple, list)) and len(spec) >= 2:
+        try:
+            return float(spec[1]) - float(spec[0])
+        except (TypeError, ValueError):
+            return 0.0
+    return 0.0

