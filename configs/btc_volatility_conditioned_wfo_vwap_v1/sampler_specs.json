{
  "schema": "regime_lab.vol_wfo_sampler_specs.v1",
  "study_id": "btc_volatility_conditioned_wfo_v1",
  "version": "VOL-WFO-V1.0",
  "samplers": {
    "S_TPE": {
      "sampler_id": "S_TPE",
      "name": "Tree-structured Parzen Estimator",
      "optuna_class": "optuna.samplers.TPESampler",
      "base_seed": 20260928,
      "seed_formula": "base_seed + fold_id * 1000",
      "n_startup_trials": 10,
      "multivariate": false,
      "group": false,
      "warn_independent_sampling": true,
      "constant_liar": false,
      "trials_per_cutoff": 128,
      "objective": "is_only_robust",
      "role": "ADAPTIVE_DENSITY_SEARCH"
    },
    "S_SOBOL": {
      "sampler_id": "S_SOBOL",
      "name": "Quasi-Monte Carlo Sobol Sequence",
      "optuna_class": "optuna.samplers.QMCSampler",
      "base_seed": 20260928,
      "seed_formula": "base_seed + fold_id * 1000",
      "qmc_type": "sobol",
      "scramble": true,
      "warn_independent_sampling": true,
      "trials_per_cutoff": 128,
      "objective": "is_only_robust",
      "role": "SPACE_FILLING_QUASI_RANDOM_SEARCH"
    }
  },
  "search_space": {
    "alpha_id": "A-SC",
    "dimensions": {
      "coeff": {
        "kind": "int",
        "low": 1,
        "high": 8,
        "step": 1,
        "num_values": 8
      },
      "AP": {
        "kind": "int",
        "low": 5,
        "high": 60,
        "step": 1,
        "num_values": 56
      },
      "alpha.condition_threshold": {
        "kind": "int",
        "low": 30,
        "high": 80,
        "step": 5,
        "num_values": 11
      }
    },
    "fixed_parameters": {
      "novolumedata": false,
      "src_col": "close"
    },
    "total_discrete_points": 4928
  },
  "pruner": {
    "class": "DuplicatePruner",
    "policy": "prune_identical_parameter_sets"
  },
  "mode4_binding": {
    "optimization_mode": "mode_4_is_only_robust",
    "optimization_schedule": "per_fold_causal",
    "candidate_selection_metric": "is_only_robust",
    "scoring_backend": "endpoint",
    "scoring_trading_days": 365,
    "is_subperiods": 6,
    "q25_weight": 0.3,
    "dispersion_penalty": 0.5,
    "temporal_weight": 0.65,
    "plateau_weight": 0.35,
    "flat_eps": 0.15,
    "flat_min_samples": 3,
    "flat_selector": "medoid"
  }
}
