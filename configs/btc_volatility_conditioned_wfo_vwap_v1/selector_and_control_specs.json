{
  "schema": "regime_lab.vol_wfo_selector_and_control_specs.v1",
  "phase": "VWFO-03",
  "study_id": "btc_volatility_conditioned_wfo_vwap_v1",
  "registered_at_utc": "2026-09-29T16:00:00Z",
  "descriptor_vector": {
    "features": [
      "dev_mult_norm",
