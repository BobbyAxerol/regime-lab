# ---------------------------------------------------------------------------
# The lab's own virtualenv and the wheels it was built from.
# Reproduce with scripts/bootstrap_lab.py + configs/requirements.lock.
# ---------------------------------------------------------------------------
environments/
wheelhouse/

# ---------------------------------------------------------------------------
# Byte-copied market data (1.4 GB). These are READ-ONLY INPUTS copied from
# ../alphas_storage, not this lab's work. Reproduce with
# scripts/snapshot_data.py; the manifest that pins them is committed under
# configs/ and snapshots/*/manifest.json is the read-lock.
# ---------------------------------------------------------------------------
snapshots/

# ---------------------------------------------------------------------------
# Scratch only: the pip cache, per-cell run checkpoints and intermediate
# parquet. Everything here is regenerated by the runner that wrote it.
# ---------------------------------------------------------------------------
.cache/

# ---------------------------------------------------------------------------
# PRIVATE SOURCE, copied into the lab as a read-only reference:
#   vendor_readonly/    the original alpha archive, the four supplied alpha
#                       files, and snapshots of QuantBT and the data loader
#   quantbt_candidate/  an independent copy of the QuantBT source tree
# None of it is this lab's work, and publishing someone's engine and strategy
# source is a decision that belongs to its owner, not to a default `git add`.
# Remove these two lines deliberately if they should be in the repo.
# ---------------------------------------------------------------------------
vendor_readonly/
quantbt_candidate/

# ---------------------------------------------------------------------------
# Python noise
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
