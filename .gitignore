# ---------------------------------------------------------------------------
# KHÔNG commit: môi trường chạy. Không phải code, không phải bằng chứng, và là
# nhị phân biên dịch riêng cho máy này nên máy khác dùng không được.
# Dựng lại bằng: scripts/bootstrap_lab.py + configs/requirements.lock
# (configs/requirements.lock ĐÃ được commit, kèm digest từng wheel trong
#  evidence/**/environment_pin.json)
# ---------------------------------------------------------------------------
environments/
wheelhouse/

# ---------------------------------------------------------------------------
# KHÔNG commit: cache của pip và checkpoint trung gian của các lần chạy.
# Mọi thứ ở đây đều do runner sinh lại được.
# ---------------------------------------------------------------------------
.cache/

# ---------------------------------------------------------------------------
# Snapshot dữ liệu thị trường: 1.4 GB parquet sao byte-by-byte từ
# ../alphas_storage. Là DỮ LIỆU, không phải code/bằng chứng/markdown.
# GIỮ LẠI manifest.json — đó chính là read-lock (SHA-256 từng file nguồn) và nó
# LÀ bằng chứng; parquet dựng lại bằng scripts/snapshot_data.py
# ---------------------------------------------------------------------------
snapshots/**/*.parquet
snapshots/**/*.arrow

# ---------------------------------------------------------------------------
# Python noise
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Numba JIT caches inside the lab (regenerable, machine-specific)
numba_cache/


# ---------------------------------------------------------------------------
# KHÔNG commit: market-slice parquet do runner ghi trong từng run
# (evidence/**/runs/*/tasks/*/raw-*/observable_market.parquet, mỗi file >100MB).
# Đây là bản sao byte của snapshot đã có read-lock; GitHub từ chối file >100MB.
# Giữ file trên disk local, giữ manifest/receipt JSON (có sha256) trong git.
# ---------------------------------------------------------------------------
evidence/**/observable_market.parquet

# ---------------------------------------------------------------------------
# KHÔNG commit: mọi file dữ liệu nhị phân (parquet/arrow/feather/HDF5/pickle/
# numpy/model binaries) ở bất cứ đâu trong repo. Lý do: GitHub từ chối file
# >100MB và dữ liệu lớn làm phình repo; manifest JSON (có sha256) + receipt +
# ledger sqlite vẫn ở trong git làm bằng chứng. File đã track trước đây không
# bị ảnh hưởng. Trường hợp ngoại lệ thật sự cần: git add -f <file>.
# ---------------------------------------------------------------------------
*.parquet
*.arrow
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.bin
*.onnx
*.pt
*.pth
*.ckpt

# ---------------------------------------------------------------------------
# KHÔNG commit: compute-cache (payload thô của mỗi lần gọi engine thật, dùng để
# tái sử dụng qua cache-hit -- xem time_edge/compute_cache.py). Đây là DỮ LIỆU
# TRUNG GIAN có thể sinh lại (rerun sẽ cache-miss rồi ghi lại y hệt), không
# phải bằng chứng cuối; report/gate_receipt/d1_table/paired_contrasts/v.v. mới
# là bằng chứng và VẪN ở trong git. Vài file compute-cache thực tế đã vượt
# 100MB (GitHub từ chối cứng) -- lý do trực tiếp khiến push thất bại trước khi
# rule này được thêm. File đã track trước đây bị gỡ khỏi lịch sử bằng
# git filter-branch một lần, ghi lại trong evidence/regime_time_edge_ra_v1/
# owner_decisions.jsonl.
# ---------------------------------------------------------------------------
evidence/**/compute-cache/
