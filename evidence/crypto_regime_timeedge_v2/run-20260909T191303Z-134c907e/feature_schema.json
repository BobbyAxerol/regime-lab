{
  "schema": "crypto_regime_lab.feature_schema.v1",
  "snapshot_id": "server_core_v1",
  "regime_observation_interval": "4h",
  "groups": {
    "G1": "direction and path shape",
    "G2": "activity / active-flow proxies",
    "G3": "leverage and crowding",
    "G4": "liquidity and absorption",
    "G5": "market coordination"
  },
  "specs": {
    "g1_rv_6": {
      "name": "g1_rv_6",
      "group": "G1",
      "scope": "local",
      "window": 6,
      "requires": [
        "close"
      ],
      "description": "realized volatility over 6 regime bars",
      "caveat": ""
    },
    "g1_direction_6": {
      "name": "g1_direction_6",
      "group": "G1",
      "scope": "local",
      "window": 6,
      "requires": [
        "close"
      ],
      "description": "sum(r)/sqrt(sum r^2): a direction descriptor",
      "caveat": "not a t-statistic"
    },
    "g1_efficiency_6": {
      "name": "g1_efficiency_6",
      "group": "G1",
      "scope": "local",
      "window": 6,
      "requires": [
        "close"
      ],
      "description": "|sum r| / sum|r|: separates directional from choppy volatility",
      "caveat": ""
    },
    "g1_downside_ratio_6": {
      "name": "g1_downside_ratio_6",
      "group": "G1",
      "scope": "local",
      "window": 6,
      "requires": [
        "close"
      ],
      "description": "share of realized variance from negative returns",
      "caveat": "a variation ratio, not a crash probability"
    },
    "g2_taker_imbalance": {
      "name": "g2_taker_imbalance",
      "group": "G2",
      "scope": "local",
      "window": null,
      "requires": [
        "taker_buy_base_volume",
        "volume"
      ],
      "description": "2*takerbuy/volume - 1 on the regime bar",
      "caveat": "both sides of every trade exist; not net capital inflow"
    },
    "g2_log_activity_30": {
      "name": "g2_log_activity_30",
      "group": "G2",
      "scope": "local",
      "window": 30,
      "requires": [
        "quote_volume"
      ],
      "description": "log(quote volume / trailing median)",
      "caveat": ""
    },
    "g2_trade_count_30": {
      "name": "g2_trade_count_30",
      "group": "G2",
      "scope": "local",
      "window": 30,
      "requires": [
        "number_of_trades"
      ],
      "description": "log(trade count / trailing median)",
      "caveat": ""
    },
    "g3_dlog_oi": {
      "name": "g3_dlog_oi",
      "group": "G3",
      "scope": "local",
      "window": null,
      "requires": [
        "sum_open_interest"
      ],
      "description": "change in log open interest",
      "caveat": "a rise is not evidence of new longs"
    },
    "g3_basis": {
      "name": "g3_basis",
      "group": "G3",
      "scope": "local",
      "window": null,
      "requires": [
        "close",
        "spot_close"
      ],
      "description": "F/S - 1 on synchronised closes",
      "caveat": "requires a spot series for the same symbol"
    },
    "g3_return_oi_interaction": {
      "name": "g3_return_oi_interaction",
      "group": "G3",
      "scope": "local",
      "window": null,
      "requires": [
        "close",
        "sum_open_interest"
      ],
      "description": "one preregistered return x OI-change interaction",
      "caveat": ""
    },
    "g4_spread_bps": {
      "name": "g4_spread_bps",
      "group": "G4",
      "scope": "local",
      "window": null,
      "requires": [
        "spread_bps"
      ],
      "description": "relative spread in basis points",
      "caveat": "a missing snapshot is missing, never a zero spread"
    },
    "g4_amihud_30": {
      "name": "g4_amihud_30",
      "group": "G4",
      "scope": "local",
      "window": 30,
      "requires": [
        "close",
        "quote_volume"
      ],
      "description": "rolling |r| / quote volume: an impact proxy",
      "caveat": ""
    },
    "g5_dispersion_6": {
      "name": "g5_dispersion_6",
      "group": "G5",
      "scope": "market",
      "window": 6,
      "requires": [
        "market_returns"
      ],
      "description": "cross-sectional dispersion of the eligible universe",
      "caveat": ""
    },
    "g5_breadth_6": {
      "name": "g5_breadth_6",
      "group": "G5",
      "scope": "market",
      "window": 6,
      "requires": [
        "market_returns"
      ],
      "description": "share of the eligible universe with a positive trailing return",
      "caveat": ""
    },
    "g5_factor_concentration_30": {
      "name": "g5_factor_concentration_30",
      "group": "G5",
      "scope": "market",
      "window": 30,
      "requires": [
        "market_returns"
      ],
      "description": "first-eigenvalue share of a trailing covariance",
      "caveat": ""
    },
    "g5_residual_return_30": {
      "name": "g5_residual_return_30",
      "group": "G5",
      "scope": "local",
      "window": 30,
      "requires": [
        "close",
        "market_returns"
      ],
      "description": "return residual to a beta fitted on a PAST window only",
      "caveat": ""
    }
  },
